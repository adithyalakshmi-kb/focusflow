# MongoDB Configuration
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/focusflow?retryWrites=true&w=majority

# For Local MongoDB (Docker):
MONGODB_URI=mongodb://admin:password123@localhost:27017/focusflow?authSource=admin

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_this
REFRESH_TOKEN_EXPIRY=30d

# Email Configuration (using Gmail, SendGrid, or your email service)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@focusflow.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# API Keys
QUOTE_API_URL=https://api.quotable.io/quotes

# Logging
LOG_LEVEL=debug
